# DealHub Zero-Budget Environment Configuration Example
# DO NOT COMMIT REAL SECRETS TO THIS FILE

# AI Provider Abstraction Configuration
# Options: free (Gemini API via process.env.GEMINI_API_KEY or AI_API_KEY), local (Ollama / local model), none (No-AI knowledge base fallback)
AI_PROVIDER=free
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
LOCAL_AI_URL=http://localhost:11434

# Optional Email Service for Manager Invitations
# If empty, invitations generate local copyable testing links
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
